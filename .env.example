# =====================================================================
# CẤU HÌNH BOT ZALO "ĐẠI CA DỮ LIỆU" - QUẢN TRỊ TIẾN ĐỘ THI CÔNG
# =====================================================================

# 1. Cổng Zalo Daemon (mặc định 3712)
ZALO_DAEMON_URL=http://127.0.0.1:3712
DEFAULT_GROUP_NAME=307 HỒ SƠ SẠT LỞ

# 2. Cấu hình AI Provider (claude / gemini)
AI_PROVIDER=claude

# 3. Khóa API Claude (Anthropic chính thức hoặc Gateway tùy chỉnh)
# - Nếu dùng Anthropic trực tiếp: để trống ANTHROPIC_BASE_URL, điền ANTHROPIC_API_KEY=sk-ant-...
# - Nếu dùng Gateway bên thứ 3: điền URL gateway (ví dụ: https://your-gateway.com) và API Key của bạn
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# 4. Model Claude (Mặc định: claude-3-5-haiku-20241022 hoặc mã model của gateway bạn dùng)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# 5. (Tùy chọn phụ nếu dùng Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
